# SafeKeep Backend - Production Environment Variables
# Create a copy of this file named `.env` and fill in your production values.

# Database
DB_URL=jdbc:postgresql://localhost:5432/safekeep
DB_USERNAME=safekeep_user
DB_PASSWORD=your_secure_password_here

# Security
# MUST be a highly secure, 512-bit Base64-encoded string in production!
JWT_SECRET=your_production_jwt_secret_base64_encoded

# Email Setup (Gmail SMTP or other provider)
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your_16_character_app_password

# SMS Setup (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# CORS & Routing
# The URL where your frontend is hosted (e.g., https://safekeep.com)
FRONTEND_URL=https://your-frontend-domain.com
